<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    
    <!-- NuGet Package Info -->
    <PackageId>Luolan.QQBot</PackageId>
    <Version>1.5.1</Version>
    <Authors>Luolan</Authors>
    <Company>Luolan</Company>
    <Description>简洁高效的 QQ 官方机器人 SDK，支持 HTTP API、WebSocket 与 Webhook 接入，自动 Token 刷新。内置速率限制器、IHttpClientFactory 支持、MVC 控制器模式、群管理 API 及 Ed25519 回调签名校验。</Description>
    <PackageTags>qq;bot;qqbot;qq-bot;qq-robot;tencent;sdk;qq-official-bot;markdown;websocket;webhook;ratelimiter;httpclientfactory</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/luolangaga/Luolan.QQBot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/luolangaga/Luolan.QQBot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.5.1: WebSocket / Webhook 改为 QQBotClientOptions.Mode 传输模式，切换模式无需修改事件订阅和控制器代码；同时包含 v1.5.0 的新域名适配、Webhook Ed25519 签名校验、群管理、单聊流式消息、分片上传、菜单/指令面板、互动响应等能力。</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.1" />
    <PackageReference Include="System.Text.Json" Version="10.0.1" />
  </ItemGroup>

</Project>
